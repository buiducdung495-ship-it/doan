# Local single-process HR storage (relative to project root)
HR_DATA_FILE=data/hr.json
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# Production: NODE_ENV=production and COOKIE_SECURE=true behind HTTPS
# Only for first setup; remove password after running hr:setup
HR_ADMIN_EMAIL=
HR_ADMIN_PASSWORD=
